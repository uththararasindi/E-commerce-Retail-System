                    <arrayElement
                      dataType="System.String"><![CDATA[#region Namespaces
using System;
using System.IO;
using System.Text.RegularExpressions;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
#endregion

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void PreExecute()
    {
        base.PreExecute();
    }

    public override void PostExecute()
    {
        base.PostExecute();
    }

    public override void CreateNewOutputRows()
    {
        string filePath =
            @"C:\Users\USER\Desktop\DWBI\project\Assignment\Assignment\archive (1)\olist_sellers_dataset.json";

        string json = System.IO.File.ReadAllText(filePath);

        // Find each JSON object separately
        MatchCollection objects = Regex.Matches(
            json,
            "\\{[^{}]*\\}",
            RegexOptions.Singleline
        );

        foreach (Match obj in objects)
        {
            string record = obj.Value;

            Match sellerIdMatch = Regex.Match(
                record,
                "\"seller_id\"\\s*:\\s*\"([^\"]*)\""
            );

            Match zipMatch = Regex.Match(
                record,
                "\"seller_zip_code_prefix\"\\s*:\\s*\"?(\\d+)\"?"
            );

            Match cityMatch = Regex.Match(
                record,
                "\"seller_city\"\\s*:\\s*\"([^\"]*)\""
            );

            Match stateMatch = Regex.Match(
                record,
                "\"seller_state\"\\s*:\\s*\"([^\"]*)\""
            );

            // Only output a row when all required seller values exist
            if (
                sellerIdMatch.Success &&
                zipMatch.Success &&
                cityMatch.Success &&
                stateMatch.Success
            )
            {
                Output0Buffer.AddRow();

                Output0Buffer.SellerId =
                    sellerIdMatch.Groups[1].Value;

                Output0Buffer.SellerZipCodePrefix =
                    Convert.ToInt32(zipMatch.Groups[1].Value);

                Output0Buffer.SellerCity =
                    cityMatch.Groups[1].Value;

                Output0Buffer.SellerState =
                    stateMatch.Groups[1].Value;
            }
        }
    }
}]]></arrayElement>
