    {
        base.PreExecute();
    }

    public override void PostExecute()
    {
        base.PostExecute();
    }

    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        Row.ConvertedWeight = SafeToDouble(
            Row.productweightg_IsNull ? null : Row.productweightg
        );

        Row.ConvertedLength = SafeToDouble(
            Row.productlengthcm_IsNull ? null : Row.productlengthcm
        );

        Row.ConvertedHeight = SafeToDouble(
            Row.productheightcm_IsNull ? null : Row.productheightcm
        );

        Row.ConvertedWidth = SafeToDouble(
            Row.productwidthcm_IsNull ? null : Row.productwidthcm
        );
    }

    private double SafeToDouble(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return 0.0;
        }

        double result;

        if (double.TryParse(
            value.Trim(),
            NumberStyles.Any,
            CultureInfo.InvariantCulture,
            out result))
        {
            return result;
        }

        return 0.0;
    }
}]]></arrayElement>
