          SQLTask:SqlStatementSource="/*&#xA;    Populate Dim_Date with one row per calendar date from 2016-01-01 to 2019-01-01.&#xA;&#xA;    The Dim_Date table may already contain data, so IF NOT EXISTS&#xA;    prevents duplicate DateKey values when this task is rerun.&#xA;*/&#xA;&#xA;SET NOCOUNT ON;&#xA;&#xA;DECLARE @StartDate DATE = '2016-01-01';&#xA;DECLARE @EndDate DATE = '2019-01-01';&#xA;&#xA;WHILE @StartDate &lt;= @EndDate&#xA;BEGIN&#xA;    IF NOT EXISTS (&#xA;        SELECT 1&#xA;        FROM Dim_Date&#xA;        WHERE DateKey =&#xA;            YEAR(@StartDate) * 10000&#xA;            + MONTH(@StartDate) * 100&#xA;            + DAY(@StartDate)&#xA;    )&#xA;    BEGIN&#xA;        INSERT INTO Dim_Date (&#xA;            DateKey,&#xA;            FullDate,&#xA;            Year,&#xA;            Quarter,&#xA;            Month,&#xA;            MonthName,&#xA;            Day,&#xA;            DayOfWeekName&#xA;        )&#xA;        VALUES (&#xA;            YEAR(@StartDate) * 10000&#xA;            + MONTH(@StartDate) * 100&#xA;            + DAY(@StartDate),&#xA;            @StartDate,&#xA;            YEAR(@StartDate),&#xA;            DATEPART(QUARTER, @StartDate),&#xA;            MONTH(@StartDate),&#xA;            DATENAME(MONTH, @StartDate),&#xA;            DAY(@StartDate),&#xA;            DATENAME(WEEKDAY, @StartDate)&#xA;        );&#xA;    END;&#xA;&#xA;    SET @StartDate = DATEADD(DAY, 1, @StartDate);&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
